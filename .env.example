# Server Configuration
PORT=3000

# Telegram Bot Credentials
# Copy this file to .env and fill in real values. Never commit real secrets.
ADMIN_BOT_TOKEN=your_admin_bot_token_from_botfather
ADMIN_CHAT_ID=123456789,987654321
ADMIN_PASSWORD=choose_a_strong_password
NORMAL_BOT_TOKEN=your_user_bot_token_from_botfather
TASHCARE_CHANNEL=https://t.me/tashcareuz

# Optional: Persistent Storage on Vercel (Upstash Redis / Vercel KV)
# In Vercel, go to "Storage" -> "Create Database" -> "KV / Upstash Redis".
# These variables will be auto-generated or you can paste from upstash.com (Free tier):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
